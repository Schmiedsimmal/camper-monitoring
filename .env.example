# =============================================================================
# Camper Monitoring - zentrale Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# =============================================================================

# --- Allgemein ----------------------------------------------------------------
# TZ für Logs und Zeitstempel
TZ=Europe/Berlin

# --- Backup-Camera Service ----------------------------------------------------
# Kamera-Quelle. Entweder RTSP-URL (z.B. rtsp://user:pass@192.168.1.10:554/...)
# oder ein USB-Device-Index (z.B. 0 fuer /dev/video0).
# Beispiele:
#   CAMERA_SOURCE=rtsp://admin:pass@192.168.1.50:554/h264_preview
#   CAMERA_SOURCE=usb:0
CAMERA_SOURCE=usb:0

# Auflösung des Substreams/Frame-Capture (Performance-Tuning)
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15

# YOLO-Modell: yolov8n (nano, schnell), yolov8s (small, genauer)
YOLO_MODEL=yolov8n.pt
# Confidence-Threshold für Bounding-Boxes (0.0 - 1.0)
YOLO_CONF_THRESHOLD=0.4
# Nur diese COCO-Klassen anzeigen (komma-separiert). Leer = alle.
# COCO-IDs: person=0, bicycle=1, car=2, motorcycle=3, bus=5, truck=7
YOLO_CLASSES=0,1,2,3,5,7
# Inferenz-Device: "auto" (CUDA wenn verfügbar, sonst CPU), "cuda:0", "cpu"
YOLO_DEVICE=auto
# TensorRT-Engine beim ersten CUDA-Start bauen und cachen (~5-10x schneller).
# Auf CPU-Hosts automatisch deaktiviert. Engine ist hardware-spezifisch.
YOLO_EXPORT_ENGINE=true
# Input-Größe für den TensorRT-Export (quadratisch). 640=Default, 416/320 schneller.
YOLO_IMG_SIZE=640
# Half-Precision (FP16) für TensorRT-Engine. Auf Jetson Nano unterstützt.
YOLO_HALF=true

# GPIO-Pin (BCM-Nummerierung) fuer das 12V-Triggersignal (Rueckfahrlicht).
# Beim Jetson Nano mit 40-Pin-Header z.B. PIN 18 = BCM 24.
TRIGGER_GPIO_PIN=24
# true: Stream laeuft nur, wenn Trigger aktiv. false: Stream immer aktiv.
TRIGGER_GATED=true

# Web-UI Port
BACKUP_CAMERA_PORT=8080

# --- PV-Monitor Service (spaeter) --------------------------------------------
# PV_INVERTER_HOST=
# PV_INVERTER_PORT=
# PV_MONITOR_PORT=8081
