[Unit]
Description=Camper Monitoring Docker Compose Stack
# Nach Docker starten, damit die Container hochkommen können.
After=docker.service
Requires=docker.service
# Kurz warten, damit USB-Geräte (Kamera) nach dem Booten erkannt werden.
# Ohne das kann der Container starten, bevor /dev/video0 verfügbar ist.

[Service]
Type=oneshot
RemainAfterExit=yes
# Pfad zum Repo anpassen falls nicht /home/simon/git/camper-monitoring
WorkingDirectory=/home/simon/git/camper-monitoring
# 5 Sekunden warten, damit USB-Geräte settle.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
# Bei Fehlern nicht endlos neu versuchen (Docker restartet Container selbst).
Restart=no

[Install]
WantedBy=multi-user.target
